# Vercel Settings > Environment Variables. Never use NEXT_PUBLIC_ for secrets.
AUTH_URL=https://YOUR-PROJECT.vercel.app
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
CRM_OWNER_EMAIL=
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
CRM_CONNECTION_ENCRYPTION_KEY=
# Optional Google Sheets service-account JSON; different from Google login OAuth.
CRM_GOOGLE_SERVICE_ACCOUNT_JSON=

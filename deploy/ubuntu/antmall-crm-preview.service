[Unit]
Description=AntMall CRM3 isolated MySQL preview
After=network-online.target mysql.service
[Service]
User=antmall-crm
Group=antmall-crm
WorkingDirectory=/srv/antmall-crm/releases/mysql-stage
Environment=NODE_ENV=production
Environment=NEXT_TELEMETRY_DISABLED=1
ExecStart=/opt/antmall-crm-node/bin/node --env-file=/srv/antmall-crm/shared/crm3.env node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3002
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
UMask=0027
MemoryMax=1200M
[Install]
WantedBy=multi-user.target

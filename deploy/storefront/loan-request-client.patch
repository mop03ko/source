+"use client";
+
+import { FormEvent, useMemo, useRef, useState, useTransition } from "react";
+import {
+  AlertCircle,
+  ArrowRight,
+  CheckCircle2,
+  ClipboardList,
+  FileText,
+  IdCard,
+  PackageCheck,
+  Phone,
+  RotateCcw,
+  ShieldCheck,
+} from "lucide-react";
+
+import { Button } from "@/components/ui/button";
+import { Input, Textarea } from "@/components/ui/form-controls";
+
+type SubmitState =
+  | { status: "idle"; message: "" }
+  | { status: "error"; message: string }
+  | {
+      antLoanRequestFormId: string;
+      customerName: string;
+      sheetAppend?: {
+        message?: string;
+        skipped?: boolean;
+        success?: boolean;
+        updatedRange?: string;
+      };
+      status: "success";
+      message: string;
+    };
+
+type LoanRequestFormResponse = {
+  ant_loan_request_form_id?: number | string;
+  errors?: Record<string, string>;
+  loan_request_form?: {
+    ant_loan_request_form?: string;
+    ant_loan_request_form_id?: number | string;
+    cust_register_no?: string;
+    req_products?: string;
+  };
+  message?: string;
+  sheet_append?: {
+    message?: string;
+    skipped?: boolean;
+    success?: boolean;
+    updatedRange?: string;
+  };
+  success?: boolean;
+};
+
+const REGISTER_EXAMPLE = "АБ12345678";
+const PHONE_EXAMPLE = "99112233";
+const PRODUCT_EXAMPLE = "iPhone 15 Pro, MacBook Air M3";
+const PHONE_PATTERN = /^\d{8}$/;
+const REGISTER_NO_PATTERN = /^[\p{Script=Cyrillic}]{2}\d{8}$/u;
+
+function normalizeRegister(value: string) {
+  const compact = value.replace(/\s+/g, "").toUpperCase();
+  const letters = compact
+    .slice(0, 2)
+    .replace(/[^\p{Script=Cyrillic}]/gu, "");
+  const digits = compact.slice(2).replace(/\D/g, "").slice(0, 8);
+
+  return `${letters}${digits}`.slice(0, 10);
+}
+
+function normalizePhone(value: string) {
+  return value.replace(/\D/g, "").slice(0, 8);
+}
+
+function getResponseMessage(data: LoanRequestFormResponse, fallback: string) {
+  if (data.message) return data.message;
+  if (data.errors) return Object.values(data.errors).filter(Boolean).join(", ");
+
+  return fallback;
+}
+
+export function LoanRequestFormClient() {
+  const requestAttempt = useRef<{payload:string;id:string}|null>(null);
+  const [contactPhone, setContactPhone] = useState("");
+  const [registerNo, setRegisterNo] = useState("");
+  const [requestedProducts, setRequestedProducts] = useState("");
+  const [customerName, setCustomerName] = useState("");
+  const [state, setState] = useState<SubmitState>({
+    status: "idle",
+    message: "",
+  });
+  const [isPending, startTransition] = useTransition();
+
+  const normalizedRegister = useMemo(
+    () => normalizeRegister(registerNo),
+    [registerNo],
+  );
+  const normalizedPhone = useMemo(
+    () => normalizePhone(contactPhone),
+    [contactPhone],
+  );
+  const isPhoneValid = PHONE_PATTERN.test(normalizedPhone);
+  const isRegisterValid = REGISTER_NO_PATTERN.test(normalizedRegister);
+
+  const isValid =
+    isPhoneValid &&
+    isRegisterValid &&
+    requestedProducts.trim().length >= 2 &&
+    customerName.trim().length >= 2;
+
+  function resetForm() {
+    requestAttempt.current = null;
+    setContactPhone("");
+    setRegisterNo("");
+    setRequestedProducts("");
+    setCustomerName("");
+    setState({ status: "idle", message: "" });
+  }
+
+  function handleSubmit(event: FormEvent<HTMLFormElement>) {
+    event.preventDefault();
+
+    if (!isValid) {
+      setState({
+        status: "error",
+        message: !isPhoneValid
+          ? "Утасны дугаар 8 оронтой тоо байх ёстой. Жишээ: 99112233"
+          : !isRegisterValid
+          ? "Регистрийн дугаар эхний 2 кирилл үсэг, дараагийн 8 цифр байх ёстой. Жишээ: АБ12110514"
+          : "Мэдээллээ бүрэн бөглөөд дахин илгээнэ үү.",
+      });
+      return;
+    }
+
+    startTransition(async () => {
+      setState({ status: "idle", message: "" });
+
+      const payload = {
+        ant_loan_request_form: customerName.trim(),
+        contact_phone: normalizedPhone,
+        cust_register_no: normalizedRegister,
+        req_products: requestedProducts.trim(),
+      };
+      const fingerprint = JSON.stringify(payload);
+      if (requestAttempt.current?.payload !== fingerprint) {
+        requestAttempt.current = {payload: fingerprint, id: crypto.randomUUID()};
+      }
+      let response: Response;
+      try {
